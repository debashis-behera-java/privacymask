live*
*-enckey.txt
*.pid

# Logs
*.log
logs/
*-out.txt
*-err.txt
verify-*.txt
test-security.txt
backend-verify*.txt

# Local manual-test payloads (may contain example PII)
request-*.json
test-request.json
