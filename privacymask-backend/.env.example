# PrivacyMask backend environment template (copy values into your shell — do NOT commit real secrets).
#
# PowerShell usage:
#   $env:PRIVACYMASK_API_KEY = "replace-with-service-key"
#
# Generate a valid encryption key (Base64 of 32 random bytes, prints a 44-char string):
#   PowerShell: $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
#   Linux/macOS: openssl rand -base64 32

# Service API key for POST /api/v1/privacymask/analyze (sent via X-API-Key header).
# No usable default: the app starts without it and protected calls return 401.
PRIVACYMASK_API_KEY=replace-with-service-key

# AES-256-GCM key for token mappings. MUST be Base64 encoding of exactly 32 random bytes.
# A raw 32-character string is NOT valid (it decodes to 24 bytes) and makes PII
# requests fail closed with HTTP 500. Never commit a real key.
PRIVACYMASK_ENCRYPTION_KEY=base64-encoding-of-32-random-bytes

# Browser CORS allow-list: exact origins, comma-separated. Empty (default) = no CORS headers.
# Local frontend development: http://localhost:5173. NEVER use "*".
PRIVACYMASK_CORS_ALLOWED_ORIGINS=

# Optional tuning (defaults shown).
PRIVACYMASK_APP_NAME=PrivacyMask
PRIVACYMASK_APP_VERSION=0.1.0
PRIVACYMASK_MAPPING_TTL=10m
PRIVACYMASK_MAX_TEXT_LENGTH=10000
PRIVACYMASK_PROVIDER_TIMEOUT=10s

# Optional rate limiting (defaults are development-oriented; tighten for production).
PRIVACYMASK_RATE_LIMIT_ENABLED=true
PRIVACYMASK_RATE_LIMIT_CAPACITY=120
PRIVACYMASK_RATE_LIMIT_REFILL_PER_MINUTE=120

# Optional real providers (backend-only; never expose these to the browser).
# The app starts without them; selecting an unconfigured provider fails safely at request time.
PRIVACYMASK_OPENAI_API_KEY=
PRIVACYMASK_OPENAI_BASE_URL=https://api.openai.com
PRIVACYMASK_OPENAI_MODEL=gpt-4o-mini
PRIVACYMASK_ANTHROPIC_API_KEY=
PRIVACYMASK_ANTHROPIC_BASE_URL=https://api.anthropic.com
PRIVACYMASK_ANTHROPIC_MODEL=claude-sonnet-4-20250514
PRIVACYMASK_ANTHROPIC_API_VERSION=2023-06-01

# Frontend (separate file: frontend/.env.example). The browser only needs the backend URL:
# VITE_PRIVACYMASK_API_URL=http://localhost:8081
