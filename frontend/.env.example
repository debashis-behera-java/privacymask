# PrivacyMask frontend configuration (Phase 13).
# Copy to .env for local development if you need to override the default.
#
# Base URL of the PrivacyMask backend. Development default is the backend on
# port 8081 (port 8080 is occupied by Docker Desktop on the dev machine).
VITE_PRIVACYMASK_API_URL=http://localhost:8081
#
# NEVER put secrets here. VITE_* variables are embedded into browser code:
# no OpenAI/Anthropic keys, no PrivacyMask production secrets, no encryption
# keys. The PrivacyMask API key is entered in the UI and kept in memory only.
